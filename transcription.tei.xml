  <text>
    <body>
      <div type="codex">
        <pb n="1" facs="#f01" />
        <div n="1" type="scan" subtype="printed-broadside-recto">
          <div type="page-face" n="single">
            <ab type="column" n="1" xml:id="f01-s-c01">
              <seg type="diplomatic-text">鴉片煙之害</seg>
            </ab>
            <ab type="column" n="2" xml:id="f01-s-c02">
              <seg type="diplomatic-text">漢口聖教書局印發</seg>
            </ab>
            <ab type="column" n="3" xml:id="f01-s-c03">
              <seg type="diplomatic-text">一費地</seg>
            </ab>
            <ab type="column" n="4" xml:id="f01-s-c04">
              <seg type="diplomatic-text">地之為用、乃種百穀生萬物、以養人及衆生者、</seg>
            </ab>
            <ab type="column" n="5" xml:id="f01-s-c05">
              <seg type="diplomatic-text">今用之栽植毒物、禍害人身、豈非顯背天心哉、</seg>
            </ab>
            <ab type="column" n="6" xml:id="f01-s-c06">
              <seg type="diplomatic-text">二費財</seg>
            </ab>
            <ab type="column" n="7" xml:id="f01-s-c07">
              <seg type="diplomatic-text">人之需財、本為仰事俯畜、贍養身家之計、若有贏餘、亦可用</seg>
            </ab>
            <ab type="column" n="8" xml:id="f01-s-c08">
              <seg type="diplomatic-text">以矜恤窮苦、今以有用之財、棄於無益之地、其惑豈不甚歟、</seg>
            </ab>
            <ab type="column" n="9" xml:id="f01-s-c09">
              <seg type="diplomatic-text">三費時</seg>
            </ab>
            <ab type="column" n="10" xml:id="f01-s-c10">
              <seg type="diplomatic-text">人生於世、光陰無幾、一分一寸、皆為古人所惜、其重可知矣、今耽於此毒、時費</seg>
            </ab>
            <ab type="column" n="11" xml:id="f01-s-c11">
              <seg type="diplomatic-text">業失而不知返、獨不思如流之歲月、刻不為留、轉瞬百事無成、徒自怨苦耳、</seg>
            </ab>
            <ab type="column" n="12" xml:id="f01-s-c12">
              <seg type="diplomatic-text">四漸至多食</seg>
            </ab>
            <ab type="column" n="13" xml:id="f01-s-c13">
              <seg type="diplomatic-text">洋煙一物、初食少許、便知自足、繼則日漸</seg>
            </ab>
            <ab type="column" n="14" xml:id="f01-s-c14">
              <seg type="diplomatic-text">求多、積至累錢累兩、勢更難除、可不畏歟、</seg>
            </ab>
            <ab type="column" n="15" xml:id="f01-s-c15">
              <seg type="diplomatic-text">五人為其奴</seg>
            </ab>
            <ab type="column" n="16" xml:id="f01-s-c16">
              <seg type="diplomatic-text">奴者、人所耻為也、一染此毒、則欲思自振、不受所挾誠難矣、雖有萬宗</seg>
            </ab>
            <ab type="column" n="17" xml:id="f01-s-c17">
              <seg type="diplomatic-text">要事、身家急計、亦必須先足其癮、然後可辦、其樂於為奴、又何意耶、</seg>
            </ab>
            <ab type="column" n="18" xml:id="f01-s-c18">
              <seg type="diplomatic-text">六內有嚒啡毒物</seg>
            </ab>
            <ab type="column" n="19" xml:id="f01-s-c19">
              <seg type="diplomatic-text">鴉片之毒、即此物也、今有人焉、持鴆毒一甌、遍請人飲、必無人受</seg>
            </ab>
            <ab type="column" n="20" xml:id="f01-s-c20">
              <seg type="diplomatic-text">之、獨至此毒、何受之者如斯之衆、豈不知其為毒耶、蓋亦自欺耳、</seg>
            </ab>
            <ab type="column" n="21" xml:id="f01-s-c21">
              <seg type="diplomatic-text">七使臟腑失調為病症之原</seg>
            </ab>
            <ab type="column" n="22" xml:id="f01-s-c22">
              <seg type="diplomatic-text">食此毒後、各經漸遭其患、失卻常功、由</seg>
            </ab>
            <ab type="column" n="23" xml:id="f01-s-c23">
              <seg type="diplomatic-text">是疾病滋生矣、病也者、人皆畏而多方</seg>
            </ab>
            <ab type="column" n="24" xml:id="f01-s-c24">
              <seg type="diplomatic-text">趨避、今則竟招之來、其愚為何如也、</seg>
            </ab>
            <ab type="column" n="25" xml:id="f01-s-c25">
              <seg type="diplomatic-text">八敗他藥之功阻病之痊愈</seg>
            </ab>
            <ab type="column" n="26" xml:id="f01-s-c26">
              <seg type="diplomatic-text">食煙之人、身體孱弱、氣力衰頹、苟患疾病、服藥</seg>
            </ab>
            <ab type="column" n="27" xml:id="f01-s-c27">
              <seg type="diplomatic-text">誠難奏效、是又安能望其痊愈、食之者當思耳、</seg>
            </ab>
            <ab type="column" n="28" xml:id="f01-s-c28">
              <seg type="diplomatic-text">九喪失天良</seg>
            </ab>
            <ab type="column" n="29" xml:id="f01-s-c29">
              <seg type="diplomatic-text">人性之惡、尚賴有天良在、冀其可以修改、今若</seg>
            </ab>
            <ab type="column" n="30" xml:id="f01-s-c30">
              <seg type="diplomatic-text">此毒、能使人失喪天良、冥頑難化、可不痛惜哉、</seg>
            </ab>
            <ab type="column" n="31" xml:id="f01-s-c31">
              <seg type="diplomatic-text">十故食之為有罪</seg>
            </ab>
            <ab type="column" n="32" xml:id="f01-s-c32">
              <seg type="diplomatic-text">既知其種種弊端、又偏好之樂之、將父母之</seg>
            </ab>
            <ab type="column" n="33" xml:id="f01-s-c33">
              <seg type="diplomatic-text">遺體、天賦之聰明、遭撞無遺、其為罪亦大矣、</seg>
            </ab>
            <ab type="column" n="34" xml:id="f01-s-c34">
              <seg type="diplomatic-text">十一禽獸亦不之食</seg>
            </ab>
            <ab type="column" n="35" xml:id="f01-s-c35">
              <seg type="diplomatic-text">人為萬物之靈、固貴於禽獸、而鴉片一物、未嘗</seg>
            </ab>
            <ab type="column" n="36" xml:id="f01-s-c36">
              <seg type="diplomatic-text">見禽獸有食之者、禽獸不食、而人食之、是人不</seg>
            </ab>
            <ab type="column" n="37" xml:id="f01-s-c37">
              <seg type="diplomatic-text">如禽獸矣、吾人豈可甘居禽獸之下哉、</seg>
            </ab>
            <ab type="page-feature" subtype="copy-annotation">
              <label>上緣右側英文鉛筆題</label>
              <seg type="diplomatic-text" rend="unknown">Exhortation against Opium</seg>
            </ab>
            <ab type="page-feature" subtype="copy-annotation">
              <label>上緣左側書號鉛筆記</label>
              <seg type="diplomatic-text" rend="unknown">Sinica 6531</seg>
            </ab>
            <ab type="page-feature" subtype="seal">
              <label>左下圓印</label>
              <seg type="diplomatic-text" rend="black">BIBLIOTHECA · BODLEIANA</seg>
            </ab>
          </div>
